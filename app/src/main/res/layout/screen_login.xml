<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/background"
        android:contentDescription="@null" />

    <!-- Dark overlay for readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <!-- Centered card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="60dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Login box card -->
        <LinearLayout
            android:id="@+id/login_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingTop="28dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="24dp">

            <!-- Title -->
            <TextView
                android:id="@+id/login_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:fontFamily="@font/torus"
            android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/login_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="@string/login_subtitle"
                android:fontFamily="@font/torus"
            android:textSize="13sp" />

            <!-- Name Input -->
            <EditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/login_hint"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingHorizontal="14dp"
                android:fontFamily="@font/torus"
            android:textSize="14sp"
                android:background="@drawable/edit_text_bg" />

            <!-- Error Text -->
            <TextView
                android:id="@+id/error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="4dp"
                android:fontFamily="@font/torus"
            android:textSize="12sp"
                android:visibility="gone" />

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- Login Button -->
            <LinearLayout
                android:id="@+id/login_btn_container"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/login_spinner"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/login_btn_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_button"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/torus"
            android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hint Card -->
            <LinearLayout
                android:id="@+id/hint_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/information_circle"
                    android:tint="?android:attr/textColorSecondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/login_hint_admin"
                    android:fontFamily="@font/torus"
            android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
