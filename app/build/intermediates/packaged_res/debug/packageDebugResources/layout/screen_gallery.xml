<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background image at full brightness -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/background"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Nav Bar -->
        <LinearLayout
            android:id="@+id/gallery_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:background="#CC1C1C1E">

            <LinearLayout
                android:id="@+id/gallery_filter_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/gallery_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gallery_filter_all"
                    android:textColor="@color/accent_blue"
                    android:fontFamily="@font/torus"
                android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/chevron_down"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/chevron_down"
                    android:tint="@android:color/white" />
            </LinearLayout>

            <!-- Spacer pushes search to right -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/gallery_search_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/search" />
        </LinearLayout>

        <!-- Search Bar (hidden by default) -->
        <LinearLayout
            android:id="@+id/search_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/gallery_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:padding="10dp"
                android:fontFamily="@font/torus"
            android:textSize="15sp" />
        </LinearLayout>

        <!-- Offline Banner -->
        <LinearLayout
            android:id="@+id/offline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/offline_orange"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/wifi"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/gallery_offline"
                android:textColor="@android:color/white"
                android:fontFamily="@font/torus"
            android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ═══ AD BANNER PLACEHOLDER ═══
             Pasang iklan di sini (misal: AdMob, Unity Ads, dll)
             Ukuran banner: match_parent x 50-90dp
             Contoh:
             <com.google.android.gms.ads.AdView
                 android:id="@+id/ad_banner"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 ads:adSize="BANNER"
                 ads:adUnitId="ca-app-pub-XXXXX" />
        -->

        <!-- Photo Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/photo_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:fontFamily="@font/torus"
            android:textSize="13sp" />
        </LinearLayout>

        <!-- Photo Grid -->
        <ScrollView
            android:id="@+id/photo_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="#33000000">

            <LinearLayout
                android:id="@+id/photo_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="80dp" />
        </ScrollView>
    </LinearLayout>

    <!-- Story FAB -->
    <FrameLayout
        android:id="@+id/story_fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="6dp">

        <View
            android:id="@+id/story_fab_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/book"
            android:tint="@android:color/white" />
    </FrameLayout>

</FrameLayout>
