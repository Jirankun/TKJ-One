<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Nav Bar -->
    <LinearLayout
        android:id="@+id/detail_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/detail_back_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:src="@drawable/arrow_back"
            android:tint="#0A84FF" />

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/torus"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@android:color/darker_gray"
            android:fontFamily="@font/torus"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/detail_download_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:padding="4dp"
            android:src="@drawable/download"
            android:tint="#0A84FF" />

        <ImageView
            android:id="@+id/detail_share_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/share_social"
            android:tint="#0A84FF" />
    </LinearLayout>

    <!-- Indeterminate loading bar: tampil selama gambar kualitas bersih dimuat,
         hilang otomatis saat gambar berhasil tampil. -->
    <ProgressBar
        android:id="@+id/detail_loading_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="#0A84FF"
        android:max="100"
        android:progress="0" />

    <!-- Media fills all available space: photo (ImageView) or video (VideoView) -->
    <FrameLayout
        android:id="@+id/detail_media_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black">

        <!--
            PENTING: layout_gravity="center" WAJIB ada di VideoView.
            VideoView mengukur dirinya sendiri mengikuti aspect ratio video (VideoView.onMeasure),
            jadi ukurannya bisa lebih kecil dari frame. Tanpa gravity, FrameLayout menaruh child
            di Gravity.TOP|START (kiri-atas) -> video terlihat miring ke kiri dan ada area hitam
            di sisi kanan. Dengan center, video selalu rata tengah dan letterbox hitam dibagi rata.
        -->
        <VideoView
            android:id="@+id/detail_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!--
            ImageView berada DI ATAS VideoView: dipakai sebagai poster thumbnail.
            Saat media masih loading, thumbnail yang sudah ada di cache ditampilkan di sini
            sehingga area media tidak pernah kosong dan drag swipe selalu kelihatan.
            Begitu video siap diputar, ImageView ini disembunyikan.
        -->
        <ImageView
            android:id="@+id/detail_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- Loading spinner for video (background transparan supaya poster thumbnail tetap
        terlihat) -->
        <LinearLayout
            android:id="@+id/detail_video_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/video_loading_bg"
            android:layout_gravity="center"
            android:padding="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
            />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_gravity="center"
                android:text="@string/loading_video"
                android:textColor="@android:color/white"
                android:fontFamily="@font/torus"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Tap-to-open overlay for videos that are not yet playing -->
        <FrameLayout
            android:id="@+id/detail_play_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/play"
                android:tint="@android:color/white" />
        </FrameLayout>
    </FrameLayout>

    <!-- Mini video player card (only visible when the current media is a video) -->
    <LinearLayout
        android:id="@+id/detail_player_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="5dp"
        android:paddingVertical="5dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/detail_prev_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/skip_previous"
            android:tint="@android:color/white" />

        <ImageView
            android:id="@+id/detail_play_pause_btn"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="4dp"
            android:padding="7dp"
            android:src="@drawable/play"
            android:tint="@android:color/white" />

        <ImageView
            android:id="@+id/detail_next_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:padding="6dp"
            android:src="@drawable/skip_next"
            android:tint="@android:color/white" />

        <SeekBar
            android:id="@+id/detail_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/detail_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/torus"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Info Footer (card bawah — tampil di foto maupun video) -->
    <LinearLayout
        android:id="@+id/detail_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Name + Type Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/create"
                android:tint="#0A84FF" />

            <TextView
                android:id="@+id/detail_photo_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/torus"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_media_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:fontFamily="@font/torus"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Date -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/calendar"
                android:tint="#0A84FF" />

            <TextView
                android:id="@+id/detail_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/torus"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Uploader -->
        <LinearLayout
            android:id="@+id/detail_uploader_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/person"
                android:tint="#0A84FF" />

            <TextView
                android:id="@+id/detail_uploader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/torus"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Copyright -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/information_circle"
                android:tint="#0A84FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/photo_copyright"
                android:fontFamily="@font/torus"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>